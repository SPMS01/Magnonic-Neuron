SetCellSize(20e-9, 10e-9, 50e-9)
SetGridSize(1200, 27, 1)
B_ext = Vector(0, 0, 300e-3)
Msat = 0
Aex = 0
alpha = 0
yig := 1

excitation_region := 2
dampener_min_region := 10
dampener_max_region := 49

Msat.SetRegion(yig, 140e3)
Aex.SetRegion(yig, 3.5e-12)
alpha.SetRegion(yig, 2e-4)

coupler := Cuboid(13.28e-6, 100e-9, 50e-9).Transl(0, 85e-9, 0)
waveguide := Cuboid(24e-6, 100e-9, 50e-9).Transl(0, -85e-9, 0)

system := waveguide.add(coupler)
SetGeom(system)
DefRegion(yig, system)

alpha_max := 0.5
damping_slice_width := 20e-9
damping_region_width := (dampener_max_region - dampener_min_region + 1) * damping_slice_width

for i := dampener_min_region; i <= dampener_max_region; i++ {
	offset := (i - dampener_min_region)
	right_lb := 12e-6 - damping_region_width + offset*damping_slice_width
	right_rb := right_lb + damping_slice_width
    
	coupler_right_lb := 6.64e-6 - damping_region_width + offset*damping_slice_width
	coupler_right_rb := coupler_right_lb + damping_slice_width
	right_dampener_region := xrange(right_lb, right_rb).
        intersect(waveguide).
        add(xrange(coupler_right_lb, coupler_right_rb).
        intersect(coupler))
	
    left_rb := -12e-6 + damping_region_width - offset*damping_slice_width
	left_lb := left_rb - damping_slice_width
	
    coupler_left_rb := -6.64e-6 + damping_region_width - offset*damping_slice_width
	coupler_left_lb := coupler_left_rb - damping_slice_width
	left_dampener_region := xrange(left_lb, left_rb).
        intersect(waveguide).
        add(xrange(coupler_left_lb, coupler_left_rb).
        intersect(coupler))
	
    dampener_region := right_dampener_region.add(left_dampener_region)
	DefRegion(i, dampener_region)
	alpha.SetRegion(i, alpha_max*(1-exp(-5.0*(i-dampener_min_region)/(dampener_max_region-dampener_min_region))))
	Msat.SetRegion(i, 140e3)
	Aex.SetRegion(i, 3.5e-12)
}

Relax()

DefRegion(excitation_region, xrange(-8.04e-6, -8e-6).intersect(waveguide))
alpha.SetRegion(excitation_region, 2e-4)
Msat.SetRegion(excitation_region, 140e3)
Aex.SetRegion(excitation_region, 3.5e-12)
// B_ext.SetRegion(excitation_region, Vector(1e-3 * sin(2 * pi * 6.7e9 * t), 0, 300e-3))

// {{ INSERT EXCITATION FIELD HERE }}

Snapshot(Msat)
Snapshot(Aex)
Snapshot(alpha)
Snapshot(geom)
Snapshot(regions)

// Save(m_full)
// AutoSave(m_full, 50e-12)

Save(m)
AutoSave(m, 50e-12)

Run(160e-9)