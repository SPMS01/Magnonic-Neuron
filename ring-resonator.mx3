SetCellSize(20e-9, 20e-9, 100e-9) // 20 nm resolution, 100nm thickness (single layer
SetGridSize(800, 82, 1) 
B_ext = Vector(0, 0, 200e-3) // 200 mT external magnetic field in z-direction
Msat = 0 // Default magnetisation saturation
Aex = 0 // Exchange stiffness constant
alpha = 2e-4 // LL damping constant
// m = Uniform(0, 0, 1) // Initial magnetization along z-direction

// === Regions ===

yig := 1
excitation_region := 2
coupler_region := 3
dampener_min_region := 10
dampener_max_region := 49

Msat.SetRegion(yig, 140e3)
Msat.SetRegion(excitation_region, 140e3)
Msat.SetRegion(coupler_region, 140e3)

Aex.SetRegion(yig, 3.5e-12)
Aex.SetRegion(excitation_region, 3.5e-12)
Aex.SetRegion(coupler_region, 3.5e-12)

// === Magnonic Neuron ===
waveguides_and_ring_translation := 160e-9

input_waveguide := Cuboid(7e-6, 300e-9, 100e-9).Transl(-4.5e-6, 670e-9, 0) // 3um long, 300nm wide, 100nm thick, 20 nm above ring
output_waveguide := Cuboid(16e-6, 300e-9, 100e-9).Transl(0, -670e-9, 0) // 3um long, 300nm wide, 100nm thick, 20 nm below ring
ring_ext := Cylinder(1e-6, 100e-9).Transl(0, 0, 0) // 1um radius, 100nm thick, centered at (0, 0, 0)
ring_int := Cylinder(400e-9, 100e-9).Transl(0, 0, 0) // 400nm radius, 100nm thick, centered at (0, 0, 0)
ring := ring_ext.sub(ring_int).Transl(-4.5e-6, 0, 0)
coupler := Cuboid(8e-6, 300e-9, 100e-9).Transl(1e-6, -350e-9, 0) // Coupling region

DefRegion(yig, input_waveguide)
DefRegion(yig, output_waveguide)
DefRegion(yig, ring)

neuron := ring.add(input_waveguide).add(output_waveguide).add(coupler)

SetGeom(neuron) // Set the geometry for the simulation

// === Edge Dampeners ===

alpha_max := 0.5
damping_slice_width := 20e-9 // 20 nm width for each dampening region
damping_region_width := (dampener_max_region - dampener_min_region + 1) * damping_slice_width

for i := dampener_min_region; i <= dampener_max_region; i++ {
    offset := (i - dampener_min_region)

    right_lb_input_waveguide := -1e-6 - damping_region_width + offset * damping_slice_width
    right_rb_input_waveguide := right_lb_input_waveguide + damping_slice_width
    right_lb_output_waveguide := 8e-6 - damping_region_width + offset * damping_slice_width
    right_rb_output_waveguide := right_lb_output_waveguide + damping_slice_width
    right_dampener_region := xrange(right_lb_input_waveguide, right_rb_input_waveguide).
        intersect(input_waveguide).
        add(xrange(right_lb_output_waveguide, right_rb_output_waveguide).
        intersect(output_waveguide))

    left_rb := -8e-6 + damping_region_width - offset * damping_slice_width
    left_lb := left_rb - damping_slice_width
    left_dampener_region := xrange(left_lb, left_rb).
        intersect(input_waveguide).
        add(xrange(left_lb, left_rb).
        intersect(output_waveguide))

    dampener_region := right_dampener_region.add(left_dampener_region)
    DefRegion(i, dampener_region)
    alpha.SetRegion(i, alpha_max * (1 - exp(-5.0 * (i - dampener_min_region) / (dampener_max_region - dampener_min_region))))
    Msat.SetRegion(i, 140e3)
    Aex.SetRegion(i, 3.5e-12)
}

// === Coupler LL damping constant ===
DefRegion(coupler_region, coupler)
alpha.SetRegion(coupler_region, 2e-2)

// === Running the Simulation ===

Relax()

Snapshot(regions)
Snapshot(Geom)
Snapshot(alpha)
Snapshot(Msat)

Save(m)
AutoSave(m, 50e-12)


// Excitation region
DefRegion(excitation_region, xrange(-1e-6 - damping_region_width - 0.1e-6, -1e-6 - damping_region_width).intersect(input_waveguide))

B_ext.SetRegion(excitation_region, Vector(0, 60e-3 * sin(2 * pi * 1.5e9 * t), 200e-3)) // excitation: 0.1 mT at 2.8 GHz, 200 mT in z-direction

// B_ext.SetRegion(excitation_region, Vector(0, 60e-3 * sinc(2 * pi * 5e9 * t), 200e-3)) 

// for i := 0; i < 3; i++ {
//     B_ext.SetRegion(excitation_region, Vector(0, 0.1e-3 * sin(2 * pi * 2.8e9 * t), 200e-3)) // excitation: 0.1 mT at 2.8 GHz, 200 mT in z-direction
//     Run(10e-9)
//     B_ext.SetRegion(excitation_region, Vector(0, 0, 200e-3)) // Turn off excitation, keep 200 mT in z-direction
//     Run(10e-9)
//     Print("pulse ", i, " done")
// }

// B_ext.SetRegion(excitation_region, Vector(0, 0, 200e-3)) // Turn off excitation, keep 200 mT in z-direction

Run(200e-9)